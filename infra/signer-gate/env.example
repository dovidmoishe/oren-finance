# Copy to /opt/oren/.env.signer-gate with owner-only filesystem permissions.
# The production Compose profile starts this container only when explicitly selected.
SIGNER_GATE_ENABLED=false
SIGNER_GATE_PORT=3001
POSTGRES_URL=postgresql://oren_signer_gate:password@db:5432/oren
SIGNER_GATE_API_TOKEN=
SIGNER_GATE_API_PUBLIC_KEY=
SIGNER_GATE_PRIVATE_KEY=
SIGNER_GATE_QUORUM_ID=
SIGNER_GATE_POLICY_ID=
SIGNER_GATE_POLICY_OWNER_ID=
SIGNER_GATE_POLICY_HASH=
# Named Privy user DIDs, comma separated. Required unless SIGNER_GATE_PUBLIC=true.
SIGNER_GATE_ALLOWED_USERS=
# Opens delegated signing to every signed-in user. Set together with
# MCP_DELEGATED_TRADES_PUBLIC on the API; grant limits still apply.
SIGNER_GATE_PUBLIC=false
SIGNER_GATE_BUYS_ENABLED=false
SIGNER_GATE_SELLS_ENABLED=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=
ALCHEMY_API_KEY=
TOKENS_API_BASE_URL=https://api.tokens.xyz
TOKENS_API_KEY=
JUPITER_API_KEY=
