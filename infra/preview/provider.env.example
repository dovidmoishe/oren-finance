# Preview-only credentials. Never copy /opt/oren/.env wholesale.
TOKENS_API_KEY=
ALCHEMY_API_KEY=
SOLANA_NETWORK=mainnet
# Financial execution, including ATA rent sponsorship, stays disabled in previews.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional quote providers, separate quotas/keys from production.
JUPITER_API_KEY=
JUPITER_MAX_RPS=0.5
TITAN_API_KEY=
TITAN_MAX_RPS=1
# Set both flags true for a signed-in internal research preview after adding the key.
DRIP_ENABLED=
DRIP_PUBLIC_RESEARCH_ENABLED=
DRIP_API_KEY=
