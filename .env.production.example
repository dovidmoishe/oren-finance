# Copy to /opt/oren/.env on the VPS. Keep it out of Git and chmod it 600.
# DOMAIN must match GitHub's PUBLIC_APP_ORIGIN variable (without /api).
DOMAIN=oren.example.com
API_DOMAIN=api.oren.example.com

# Postgres is application memory, not the financial ledger.
POSTGRES_USER=oren
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
POSTGRES_DB=oren
POSTGRES_URL=postgresql://oren:replace-with-a-long-random-url-safe-password@db:5432/oren

PORT=3000
CORS_ORIGIN=https://oren.example.com
TOKENS_API_BASE_URL=https://api.tokens.xyz
TOKENS_API_KEY=
ALCHEMY_API_KEY=
SOLANA_NETWORK=mainnet
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_TRIGGER_API_URL=
JUPITER_TRACKING_ACCOUNT=
DUNE_API_KEY=
DUNE_API_BASE_URL=https://api.dune.com/api/v1
DUNE_UPLOAD_NAMESPACE=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
BITGET_API_BASE_URL=https://api.bitget.com
BITGET_REQUEST_TIMEOUT_MS=8000
VAULT_PROGRAM_ID=4yBSLwXvYQhHExDuvuuEsaHfUC392SdRSiM8r6m832Mj
VAULT_PROGRAM_LIVE=false
