# JSON access logs in the caddy_data volume, read by infra/visits.sh.
# Caddy redacts Cookie and Authorization headers by default.
(access_log) {
	log {
		output file /data/access/{args[0]}.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 2160h
		}
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$DOMAIN} {
	import access_log site
	encode zstd gzip
	import security_headers
	reverse_proxy app:3000
}

{$API_DOMAIN} {
	import access_log api
	encode zstd gzip
	import security_headers
	reverse_proxy api:3000
}
